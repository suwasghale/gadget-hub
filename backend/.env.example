# =============================================================================
# gadget-hub backend environment
# =============================================================================
# Copy to backend/.env and fill in the values. Never commit the real .env.

# -----------------------------------------------------------------------------
# Core Django
# -----------------------------------------------------------------------------
# REQUIRED in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# SECRET_KEY=

DEBUG=True

# REQUIRED in production. Comma-separated.
ALLOWED_HOSTS=127.0.0.1,localhost

# -----------------------------------------------------------------------------
# Database (MySQL)
# -----------------------------------------------------------------------------
DB_NAME=gadget_hub
DB_USER=gadget_hub
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307

# -----------------------------------------------------------------------------
# CORS / CSRF
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production only. Defaults to CORS_ALLOWED_ORIGINS.
# CSRF_TRUSTED_ORIGINS=

# -----------------------------------------------------------------------------
# Email
# -----------------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# -----------------------------------------------------------------------------
# Media storage (Cloudinary)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------------------------------------------------------
# Payments
# -----------------------------------------------------------------------------
KHALTI_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Production transport security (config.settings.prod)
# -----------------------------------------------------------------------------
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# Set True when behind a TLS-terminating proxy such as nginx.
# USE_X_FORWARDED_PROTO=False
